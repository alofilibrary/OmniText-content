# Python bytecode is local execution residue, never source.
__pycache__/
*.py[cod]

# Generated packs can be huge and are published as immutable GitHub Release assets.
packs/*.otpack
packs/*.db

# Pinned upstream material and generated packs are acquired/built locally for
# reproducible conversion, but release payloads are never committed to Git.
.sources/
data/raw/
dist/

# Keep the directory in Git without checking in payloads.
!packs/.gitkeep
